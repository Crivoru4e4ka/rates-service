# ---------------------------------------------------------------------------
# Rates Service — переменные окружения (полный список из internal/config/config.go).
#
# Как пользоваться: скопируй файл в .env (cp .env.example .env) и правь под себя.
# .env НЕ коммитится — локальные секреты и переопределения живут только локально.
# Значения ниже = дефолты из internal/config/config.go; чтобы переопределить —
# раскомментируй строку и поменяй значение.
# ---------------------------------------------------------------------------

# --- Провайдер котировок ---
# frankfurter       — открытый API референсных курсов ЕЦБ, ключ не нужен (по умолчанию)
# exchangeratesapi  — https://exchangeratesapi.io/, требует RATES_API_KEY
RATES_PROVIDER=frankfurter

# Ключ нужен только для RATES_PROVIDER=exchangeratesapi.
RATES_API_KEY=

# Базовый URL API; по умолчанию подставляется по провайдеру:
#   frankfurter       -> https://api.frankfurter.dev/v1
#   exchangeratesapi  -> https://api.exchangeratesapi.io/v1
# (переопределяет только ОСНОВНОГО провайдера; резервный всегда использует
# канонический URL своего API)
# RATES_API_URL=https://api.frankfurter.dev/v1

# Автоматический фолбэк включён всегда: при сбое основного провайдера
# (после его ретраев) запрос уходит ко второму — если тот применим
# (для exchangeratesapi как резервного нужен непустой RATES_API_KEY).
# Метрика переключений: rates_fallback_total.

# --- Вызовы внешнего API (resilience) ---
# Таймаут одного вызова провайдера.
# RATES_PROVIDER_TIMEOUT=5s
# Всего попыток (включая первую); ретраи — только для транзистентных ошибок (429/403/5xx, сеть).
# PROVIDER_MAX_ATTEMPTS=3
# Базовая задержка перед повтором; экспоненциальный backoff с джиттером ±20%.
# PROVIDER_RETRY_BASE_DELAY=500ms
# Потолок задержки между попытками.
# PROVIDER_RETRY_MAX_DELAY=10s
# Минимальный ГЛОБАЛЬНЫЙ интервал между вызовами внешнего API (защита квоты).
# PROVIDER_MIN_INTERVAL=1s
# TTL кэша ответов провайдера: повторные запросы пары не тратят квоту. 0 — выключить.
# PROVIDER_CACHE_TTL=60s

# --- HTTP-сервер ---
# Адрес HTTP-сервера.
# HTTP_ADDR=:8080
# Таймауты HTTP-сервера.
# HTTP_READ_TIMEOUT=5s
# HTTP_WRITE_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s
# Время на graceful shutdown после SIGINT/SIGTERM.
# SHUTDOWN_TIMEOUT=15s
# Поднять /debug/pprof (профилирование CPU/памяти/горутин).
# PPROF_ENABLED=false

# --- Фоновые воркеры ---
# Число воркеров, разбирающих очередь обновлений котировок.
# WORKERS=4
# Размер очереди; при переполнении запросы остаются pending и подхватываются resync-тикетом.
# QUEUE_SIZE=1024
# Период повторной постановки pending-запросов в очередь (также один раз при старте).
# RESYNC_INTERVAL=30s

# --- Хранение ---
# Подключение к PostgreSQL (миграции применяются автоматически при старте).
# DATABASE_URL=postgres://rates:rates@localhost:5432/rates?sslmode=disable
# Валюты, разрешённые в парах: BASE и QUOTE пары должны быть из этого списка.
# SUPPORTED_CURRENCIES=USD,EUR,MXN

# --- Логи ---
# Уровень детализации: debug | info | warn | error.
# LOG_LEVEL=info
# Формат вывода: text | json.
# LOG_FORMAT=text
